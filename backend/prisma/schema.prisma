// SoftwareProjectRisk - Prisma schema (PHASE 1: Project only)
// หมายเหตุ: ID / naming ยังเป็นค่าที่เราเลือกเอง ยังไม่ได้ตรวจกับ CSMJU2030 Standards

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScenarioChangeFactor {
  BUDGET
  TEAM_SIZE
  TASK_DURATION
  RISK_PROBABILITY
  RISK_IMPACT
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  budget      Decimal       @db.Decimal(14, 2)
  teamSize    Int
  status      ProjectStatus @default(PLANNING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks     Task[]
  risks     Risk[]
  scenarios Scenario[]

  @@map("projects")
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  duration    Int
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // เลือก Cascade เพื่อความง่าย (ยังไม่ใช่ CSMJU2030 convention) — ลบ Task แล้ว dependency ที่เกี่ยวข้องถูกลบตาม
  dependsOn  TaskDependency[] @relation("TaskDependsOn") // แถวที่ task นี้เป็นฝ่าย "ขึ้นกับ"
  dependedBy TaskDependency[] @relation("TaskDependedBy") // แถวที่ task อื่น "ขึ้นกับ" task นี้
  scenarioChanges ScenarioChange[] // ScenarioChange ที่ factor = TASK_DURATION ชี้มาที่ task นี้

  @@map("tasks")
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  task            Task     @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependedBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([taskId, dependsOnTaskId]) // กัน duplicate dependency ระดับฐานข้อมูล
  @@map("task_dependencies")
}

model Risk {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  probability Int // 1-5, ตรวจที่ DTO (RiskCalculator ตรวจซ้ำเป็นด่านสุดท้ายก่อนคำนวณ)
  impact      Int // 1-5
  score       Int // = probability * impact, backend คำนวณเสมอ (ดู src/risks/risk-calculator.ts)
  level       RiskLevel // มาจาก score เสมอ, client กำหนดเองไม่ได้
  mitigation  String?
  contingency String?
  owner       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  scenarioChanges ScenarioChange[] // ScenarioChange ที่ factor = RISK_PROBABILITY/RISK_IMPACT ชี้มาที่ risk นี้

  @@map("risks")
}

model Scenario {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  changes     ScenarioChange[]
  simulations Simulation[]

  @@map("scenarios")
}

model ScenarioChange {
  id         String               @id @default(uuid())
  scenarioId String
  scenario   Scenario             @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  factor     ScenarioChangeFactor

  // ใช้เฉพาะ factor = TASK_DURATION (ต้องอยู่ project เดียวกับ scenario, ตรวจที่ service)
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // ใช้เฉพาะ factor = RISK_PROBABILITY / RISK_IMPACT (ต้องอยู่ project เดียวกับ scenario, ตรวจที่ service)
  riskId String?
  risk   Risk?   @relation(fields: [riskId], references: [id], onDelete: Cascade)

  // ค่าใหม่ที่ผู้ใช้กำหนด (before ดึงจากฐานข้อมูลจริงเสมอ ไม่รับจาก client — ดู SimulationsService)
  // เก็บเป็น Decimal เดียวรองรับทั้งจำนวนเต็ม (team/duration/probability/impact) และทศนิยม (budget)
  newValue Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@map("scenario_changes")
}

model Simulation {
  id         String   @id @default(uuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  executedAt      DateTime @default(now())
  formulaVersion  String   @default("1.0")

  beforeDuration Int
  afterDuration  Int
  durationChange Int

  beforeBudget Decimal @db.Decimal(14, 2)
  afterBudget  Decimal @db.Decimal(14, 2)
  budgetChange Decimal @db.Decimal(14, 2)
  // null เมื่อ beforeBudget = 0 (กันหารด้วยศูนย์)
  budgetChangePercent Decimal? @db.Decimal(10, 4)

  beforeTeamSize Int
  afterTeamSize  Int

  // Risk ที่ถูกกระทบเท่านั้น (ไม่ใช่ทุก Risk ของ Project) — array เพราะ Scenario เดียวเปลี่ยนได้หลาย Risk
  riskChanges Json

  impactSummary  String[]
  recommendation String[]

  @@map("simulations")
}
